{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/anabsolutesloth/cobblemonboxlink-multiloader",
        "issues": "https://github.com/anabsolutesloth/cobblemonboxlink-multiloader/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}_icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.emperdog.boxlink.BoxLinkFabricMod"
        ]
    },
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}",
        "cobblemon": ">=${cobblemon_version}"
    },
    "suggests": {
        "curios": ">=${curios_version}"
    }
}
  